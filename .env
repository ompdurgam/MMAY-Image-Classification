# ─────────────────────────────────────────────────────────
#  MMAY (Mukhyamantri Avas Yojana) – Environment Variables
# ─────────────────────────────────────────────────────────

# Model
MODEL_PATH=model/MMAY_EfficientNetV2M_final.keras
IMG_HEIGHT=300
IMG_WIDTH=300

# Inference
CONFIDENCE_THRESHOLD=0.70

# Level → class label  (keys must be integers as strings)
LEVEL_CLASS_MAP={"2":"plinth","3":"roof_cast","4":"completion"}

# Model output index → class label  (must match training order)
CLASS_INDEX_MAP={"0":"completion","1":"plinth","2":"roof_cast"}

# Server
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# Upload guards
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ── Security ──────────────────────────────────────────────────────────────────
# CORS: comma-separated list of allowed origins.
# Use * ONLY for local development; restrict to real domains in production.
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8080

# Batch endpoint filesystem sandbox.
# All image paths in /predict/batch must be RELATIVE and must resolve
# to a file inside this directory.  Absolute paths and traversal sequences
# (../../) are rejected before any file I/O is performed.
BATCH_IMAGE_ROOT=images